+﻿# =============================================================================
+# TorVPN -- DNS teardown
+# =============================================================================
+# Called by the service on disengage. Removes NRPT rule and DNS firewall rules.
+# Safe to call repeatedly.
+# =============================================================================
+$ErrorActionPreference = "SilentlyContinue"
+$group = "TORVPN"
+
+# Remove our NRPT rule
+Get-DnsClientNrptRule |
+    Where-Object { $_.DisplayName -eq "TORVPN Default" } |
+    Remove-DnsClientNrptRule -Force | Out-Null
+
+# Remove DNS-specific firewall rules
+Get-NetFirewallRule -Group $group |
+    Where-Object { $_.DisplayName -like "TORVPN DNS*" } |
+    Remove-NetFirewallRule | Out-Null
+
+Write-Host "[+] NRPT + DNS lock removed"
diff -ruN '--exclude=target' '--exclude=Output' '--exclude=.git' torvpn_extract/tor-vpn/scripts/fw-apply.ps1 torvpn-build/scripts/fw-apply.ps1
--- torvpn_extract/tor-vpn/scripts/fw-apply.ps1	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/scripts/fw-apply.ps1	2026-09-06 16:45:37.797542309 +0000
@@ -0,0 +1,117 @@
+# =============================================================================
+# TorVPN -- Firewall apply (kill-switch)
+# =============================================================================
+# Called by the service when engaging. Receives a JSON arg with:
+#   { "AdapterHint": "torvpn", "TorPath": "C:\Program Files\TorVPN\tor\tor.exe" }
+#
+# WHY THIS SCRIPT WAS REWRITTEN
+# -----------------------------
+# The previous version added an explicit "Block All Outbound" *rule* and then
+# explicit Allow rules for tor.exe / Wintun. On Windows Filtering Platform,
+# an explicit Block rule ALWAYS wins over an explicit Allow rule, so that
+# design blocked tor.exe too -- tor could never reach the network, so it never
+# bootstrapped, so "Connect" did nothing.
+#
+# The correct kill-switch pattern (what commercial VPNs use):
+#   * Set the profile DefaultOutboundAction to Block. The default action is the
+#     LOWEST-priority fallback -- it only applies when no explicit rule matches.
+#   * Add explicit Allow rules for exactly what must escape: tor.exe (the only
+#     process that legitimately talks to the public internet), loopback (the
+#     tray <-> service and tun2socks <-> tor plumbing), and the Wintun adapter.
+# Everything else falls through to the default -> blocked. Teardown restores
+# DefaultOutboundAction = Allow.
+# =============================================================================
+param($jsonArgs)
+
+$ErrorActionPreference = "Stop"
+
+if ($jsonArgs -is [string] -and $jsonArgs.Length -gt 0) {
+    $argsObj = $jsonArgs | ConvertFrom-Json
+} else {
+    $argsObj = $null
+}
+
+$AdapterHint = if ($argsObj) { $argsObj.AdapterHint } else { "torvpn" }
+$TorPath     = if ($argsObj) { $argsObj.TorPath }     else { "" }
+$group       = "TORVPN"
+
+# ----- Clean any leftover rules from the group --------------------------------
+Get-NetFirewallRule -Group $group -ErrorAction SilentlyContinue |
+    Remove-NetFirewallRule -ErrorAction SilentlyContinue | Out-Null
+
+# =============================================================================
+# 1. ALLOW rules first, so there is never a window where tor is blocked once we
+#    flip the default action.
+# =============================================================================
+
+# ----- Allow tor.exe (the only process that egresses to the real internet) ---
+$torAllowed = $false
+if (-not [string]::IsNullOrEmpty($TorPath) -and (Test-Path $TorPath)) {
+    New-NetFirewallRule `
+        -DisplayName "TORVPN Allow Tor" `
+        -Group       $group `
+        -Program     $TorPath `
+        -Direction   Outbound `
+        -Action      Allow `
+        -Enabled     True | Out-Null
+    $torAllowed = $true
+} else {
+    # Fall back to whatever's in PATH (bundled deployments should hit the branch above).
+    $tor = Get-Command tor.exe -ErrorAction SilentlyContinue
+    if ($tor) {
+        New-NetFirewallRule `
+            -DisplayName "TORVPN Allow Tor (PATH)" `
+            -Group       $group `
+            -Program     $tor.Path `
+            -Direction   Outbound `
+            -Action      Allow `
+            -Enabled     True | Out-Null
+        $torAllowed = $true
+    }
+}
+
+if (-not $torAllowed) {
+    # No tor allow rule == a kill-switch that blocks EVERYTHING including tor.
+    # Refuse to flip the default action; that would just kill the user's
+    # network for no benefit. Fail loud so the service reports an error.
+    throw "[TORVPN] tor.exe not found (TorPath='$TorPath') -- refusing to enable kill-switch with no Tor allow rule"
+}
+
+# ----- Allow loopback (tray <-> svc, tun2socks <-> tor) ----------------------
+# Windows normally exempts loopback from WFP, but make it explicit so the
+# control plane is guaranteed to work under DefaultOutboundAction=Block.
+New-NetFirewallRule `
+    -DisplayName   "TORVPN Allow Loopback" `
+    -Group         $group `
+    -Direction     Outbound `
+    -Action        Allow `
+    -RemoteAddress "127.0.0.0/8" `
+    -Enabled       True | Out-Null
+
+# ----- Allow traffic bound to the Wintun adapter (belt-and-braces) -----------
+$adapter = Get-NetAdapter |
+    Where-Object {
+        $_.InterfaceDescription -like "*Wintun*" -or
+        $_.Name                  -like "*$AdapterHint*"
+    } |
+    Select-Object -First 1
+
+if ($adapter) {
+    New-NetFirewallRule `
+        -DisplayName    "TORVPN Allow Wintun" `
+        -Group          $group `
+        -InterfaceAlias $adapter.Name `
+        -Direction      Outbound `
+        -Action         Allow `
+        -Enabled        True | Out-Null
+} else {
+    Write-Warning "[!] Wintun adapter not found (hint='$AdapterHint') -- tunnel allow rule skipped"
+}
+
+# =============================================================================
+# 2. Flip the kill-switch: default-deny outbound on all profiles. Explicit
+#    Allow rules above are the only holes.
+# =============================================================================
+Set-NetFirewallProfile -All -DefaultOutboundAction Block | Out-Null
+
+Write-Host "[+] Kill-switch active (default-deny outbound; tor + loopback + Wintun allowed) for group $group"
diff -ruN '--exclude=target' '--exclude=Output' '--exclude=.git' torvpn_extract/tor-vpn/scripts/fw-teardown.ps1 torvpn-build/scripts/fw-teardown.ps1
--- torvpn_extract/tor-vpn/scripts/fw-teardown.ps1	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/scripts/fw-teardown.ps1	2026-09-06 16:45:44.681542478 +0000
@@ -0,0 +1,22 @@
+# =============================================================================
+# TorVPN -- Firewall teardown
+# =============================================================================
+# Called by the service on disengage. Reverses fw-apply.ps1:
+#   1. Restore DefaultOutboundAction = Allow on all profiles (this is the
+#      Windows factory default -- without it, disengaging would leave the
+#      machine with NO internet).
+#   2. Remove every rule tagged with our group.
+# Safe to call repeatedly.
+# =============================================================================
+$ErrorActionPreference = "SilentlyContinue"
+$group = "TORVPN"
+
+# 1. Lift the kill-switch FIRST, so connectivity is restored even if rule
+#    removal below hiccups.
+Set-NetFirewallProfile -All -DefaultOutboundAction Allow | Out-Null
+
+# 2. Remove our allow/loopback/wintun rules.
+Get-NetFirewallRule -Group $group |
+    Remove-NetFirewallRule | Out-Null
+
+Write-Host "[+] Kill-switch lifted (default-allow restored) and group $group rules removed"
diff -ruN '--exclude=target' '--exclude=Output' '--exclude=.git' torvpn_extract/tor-vpn/scripts/route-apply.ps1 torvpn-build/scripts/route-apply.ps1
--- torvpn_extract/tor-vpn/scripts/route-apply.ps1	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/scripts/route-apply.ps1	2026-09-06 17:15:10.057585882 +0000
@@ -0,0 +1,95 @@
+# =============================================================================
+# TorVPN -- Split-tunnel routing apply
+# =============================================================================
+# Called by the service AFTER tun2socks has created the Wintun adapter.
+# Receives JSON:
+#   { "AdapterHint": "torvpn", "GuardIps": ["185.x.y.z", ...] }
+#
+# What it does, in order:
+#   1. Wait for the Wintun adapter to appear (tun2socks may still be starting).
+#   2. Find the current PHYSICAL default gateway (the real uplink).
+#   3. Pin a /32 host route for each tor guard IP via that physical gateway, so
+#      tor's own guard traffic never re-enters the tunnel (no routing loop).
+#   4. Give the Wintun adapter an address + a low interface metric.
+#   5. Point the default route at the tunnel gateway.
+#
+# Wintun is a layer-3 adapter (no Ethernet/ARP), so an on-link "gateway" address
+# in the tunnel subnet is reached without ARP -- this is the standard tun2socks
+# pattern. All routes are NON-persistent (no `route -p`), so a reboot wipes them:
+# that's the emergency escape hatch if anything goes wrong.
+# =============================================================================
+param($jsonArgs)
+
+$ErrorActionPreference = "Stop"
+
+# ---- Tunnel address plan. If 10.86.1.0/24 clashes with your LAN, change these
+#      three (and the matching /32 default in route-teardown.ps1). --------------
+$TunIp     = "10.86.1.2"
+$TunMask   = "255.255.255.0"
+$TunGw     = "10.86.1.1"
+$TunMetric = 1
+
+if ($jsonArgs -is [string] -and $jsonArgs.Length -gt 0) {
+    $argsObj = $jsonArgs | ConvertFrom-Json
+} else {
+    throw "route-apply: missing JSON args"
+}
+$AdapterHint = if ($argsObj.AdapterHint) { $argsObj.AdapterHint } else { "torvpn" }
+# ConvertFrom-Json yields a scalar for a single-element array; normalise to array.
+$GuardIps = @($argsObj.GuardIps | Where-Object { $_ })
+
+if ($GuardIps.Count -eq 0) {
+    throw "route-apply: no guard IPs supplied -- refusing to move the default route (would loop tor)"
+}
+
+# ----- 1. Wait for the Wintun adapter ----------------------------------------
+$deadline = (Get-Date).AddSeconds(15)
+$adapter = $null
+do {
+    $adapter = Get-NetAdapter -ErrorAction SilentlyContinue |
+        Where-Object {
+            $_.Status -eq "Up" -and (
+                $_.InterfaceDescription -like "*Wintun*" -or
+                $_.Name                  -like "*$AdapterHint*"
+            )
+        } |
+        Select-Object -First 1
+    if ($adapter) { break }
+    Start-Sleep -Milliseconds 500
+} while ((Get-Date) -lt $deadline)
+
+if (-not $adapter) {
+    throw "route-apply: Wintun adapter not found (hint '$AdapterHint') after 15s"
+}
+$tunIf = $adapter.ifIndex
+
+# ----- 2. Physical default gateway (anything that isn't our tunnel) ----------
+$phys = Get-NetRoute -DestinationPrefix "0.0.0.0/0" -ErrorAction SilentlyContinue |
+    Where-Object { $_.ifIndex -ne $tunIf -and $_.NextHop -ne "0.0.0.0" } |
+    Sort-Object RouteMetric |
+    Select-Object -First 1
+
+if (-not $phys) {
+    throw "route-apply: no physical default gateway found -- cannot pin guard routes"
+}
+$gw     = $phys.NextHop
+$physIf = $phys.ifIndex
+Write-Host "[*] Physical uplink: gateway $gw via ifIndex $physIf"
+
+# ----- 3. Pin guard /32s to the physical gateway (loop prevention) -----------
+foreach ($g in $GuardIps) {
+    # Idempotent: drop any stale copy first, then add.
+    & route delete $g 2>$null | Out-Null
+    & route add $g mask 255.255.255.255 $gw metric 1 if $physIf | Out-Null
+    Write-Host "    guard $g -> $gw (physical)"
+}
+
+# ----- 4. Wintun address + low interface metric ------------------------------
+& netsh interface ip set address name="$($adapter.Name)" static $TunIp $TunMask | Out-Null
+& netsh interface ipv4 set interface interface="$($adapter.Name)" metric=$TunMetric | Out-Null
+
+# ----- 5. Default route onto the tunnel --------------------------------------
+& route delete 0.0.0.0 mask 0.0.0.0 $TunGw 2>$null | Out-Null
+& route add 0.0.0.0 mask 0.0.0.0 $TunGw metric $TunMetric if $tunIf | Out-Null
+
+Write-Host "[+] Split tunnel up: default -> Wintun ($($adapter.Name)), $($GuardIps.Count) guard(s) pinned to physical"
diff -ruN '--exclude=target' '--exclude=Output' '--exclude=.git' torvpn_extract/tor-vpn/scripts/route-teardown.ps1 torvpn-build/scripts/route-teardown.ps1
--- torvpn_extract/tor-vpn/scripts/route-teardown.ps1	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/scripts/route-teardown.ps1	2026-09-06 17:15:23.821586221 +0000
@@ -0,0 +1,55 @@
+# =============================================================================
+# TorVPN -- Split-tunnel routing teardown
+# =============================================================================
+# Called by the service on disengage, BEFORE tun2socks is stopped, and also
+# defensively on service start-up (to clear a previous crash's routes).
+# Receives JSON:
+#   { "AdapterHint": "torvpn", "GuardIps": ["185.x.y.z", ...] }
+#
+# Removes the tunnel default route and the guard /32s. The PHYSICAL default
+# route was never removed by apply (only out-prioritised), so deleting the
+# tunnel default hands connectivity straight back to the real uplink.
+#
+# Safe to call repeatedly and safe to call when nothing is applied. Errors are
+# swallowed on purpose -- this is cleanup, and a half-present state must still
+# end clean.
+# =============================================================================
+param($jsonArgs)
+
+$ErrorActionPreference = "SilentlyContinue"
+
+# Must match route-apply.ps1.
+$TunGw = "10.86.1.1"
+
+$AdapterHint = "torvpn"
+$GuardIps    = @()
+if ($jsonArgs -is [string] -and $jsonArgs.Length -gt 0) {
+    try {
+        $argsObj = $jsonArgs | ConvertFrom-Json
+        if ($argsObj.AdapterHint) { $AdapterHint = $argsObj.AdapterHint }
+        $GuardIps = @($argsObj.GuardIps | Where-Object { $_ })
+    } catch { }
+}
+
+# 1. Drop the tunnel default route (restores the physical default immediately).
+& route delete 0.0.0.0 mask 0.0.0.0 $TunGw 2>$null | Out-Null
+
+# 2. Belt-and-braces: remove ANY default route still sitting on the Wintun
+#    adapter, in case the address plan was edited or a stale one lingers.
+$adapter = Get-NetAdapter -ErrorAction SilentlyContinue |
+    Where-Object {
+        $_.InterfaceDescription -like "*Wintun*" -or
+        $_.Name                  -like "*$AdapterHint*"
+    } |
+    Select-Object -First 1
+if ($adapter) {
+    Remove-NetRoute -InterfaceIndex $adapter.ifIndex -DestinationPrefix "0.0.0.0/0" `
+        -Confirm:$false -ErrorAction SilentlyContinue
+}
+
+# 3. Remove the guard /32 host routes we pinned to the physical gateway.
+foreach ($g in $GuardIps) {
+    & route delete $g 2>$null | Out-Null
+}
+
+Write-Host "[+] Split tunnel torn down (default route restored to physical uplink)"
