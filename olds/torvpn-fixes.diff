+dns_port                = 53
+control_port            = 9051
+use_bridges             = true
+client_transport_plugin = "C:\\Program Files\\TorVPN\\obfs4proxy\\obfs4proxy.exe"
+bridges = [
+  # Replace with real bridges from https://bridges.torproject.org/ — example
+  # format only:
+  # "obfs4 192.0.2.10:443 ABCDEF... cert=... iat-mode=0",
+]
+tor_path_hint = ""
+
+[tun2socks]
+binary = "tun2socks.exe"
+
+[proxy]
+enabled  = false
+rotation = "off"
+proxies  = []
+
+[exit]
+countries = []
+strict    = true
+
+[pqc]
+enabled  = false
+algo_sig = "dilithium2"
+algo_kem = "kyber1024"
+
+[hop]
+enabled      = false
+randomize    = false
+loop_forever = true
+jitter       = "0s"
+sequence     = []
+
+[perf]
+# Bridges already constrain throughput; we relax the speed knobs a touch so
+# we don't churn circuits unnecessarily on a slower path. tun2socks dials one
+# SOCKS port, so 1 is correct here too (see default_win.toml for the why).
+parallel_socks_ports       = 1
+circuit_build_timeout_secs = 20
+num_entry_guards           = 1
+ipv4_only                  = true
+disable_padding            = false   # keep padding on for bridge users
