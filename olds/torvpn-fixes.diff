-    let mut cmd = Command::new("powershell");
-    cmd.arg("-NoProfile")
-       .arg("-ExecutionPolicy").arg("Bypass")
-       .arg("-File").arg(&script);
-    if let Some(j) = json_args { cmd.arg(j); }
-    cmd.status().await.with_context(|| format!("run {}", script.display()))?;
-    Ok(())
