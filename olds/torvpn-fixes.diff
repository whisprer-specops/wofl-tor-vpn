--- torvpn_extract/tor-vpn/profiles/default_win.toml	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/profiles/default_win.toml	2026-09-06 17:16:22.473587663 +0000
@@ -0,0 +1,109 @@
+# =============================================================================
+# TorVPN — Windows default profile (SPEED-FIRST)
+# =============================================================================
+# This is the bundled default. The installer drops a copy at
+#   %ProgramData%\torvpn\profile.toml
+# which users / admins can edit. The service falls back to this baked-in copy
+# if no override file exists.
+#
+# Tunable knobs you'll likely care about live in the [perf] section.
+# =============================================================================
+
+[status]
+enabled = true
+# Local-only control plane the tray and CLI talk to.
+listen  = "127.0.0.1:8787"
+
+# ---------- TUN / Wintun ------------------------------------------------------
+[tun]
+interface = "torvpn"
+mtu       = 1400
+# Full-device VPN: push ALL traffic through the tunnel (default). For a cautious
+# first run set this to false — tor still engages and you can confirm the exit IP
+# via the tray/status, but your system routing, DNS and firewall are left
+# completely untouched. Flip to true once you've proven engagement on your box.
+full_tunnel = true
+
+# ---------- Tor daemon --------------------------------------------------------
+[tor]
+socks_port              = 9050
+# Tor's DNS resolver port. This MUST be 53: Windows NRPT (the DNS lock in
+# dns-apply.ps1) can only forward queries to a nameserver on port 53, so tor has
+# to listen there for system DNS to resolve through the tor network. The service
+# runs as LocalSystem, so binding loopback:53 is fine — UNLESS you already run a
+# local DNS server (Pi-hole, dnscrypt-proxy, a dev resolver) on 127.0.0.1:53, in
+# which case tor won't start. Free that port, or point the other resolver away.
+dns_port                = 53
+control_port            = 9051
+use_bridges             = false
+client_transport_plugin = ""
+bridges                 = []
+# Leave blank to auto-discover (bundled `tor\tor.exe` next to the service exe,
+# then PATH). Set to an absolute path to override.
+tor_path_hint           = ""
+
+# ---------- tun2socks ---------------------------------------------------------
+[tun2socks]
+binary = "tun2socks.exe"
+
+# ---------- Upstream proxy chain (off by default; Tor is the only hop) --------
+[proxy]
+enabled  = false
+rotation = "off"
+proxies  = []
+
+# ---------- Exit-country pinning ---------------------------------------------
+# Empty = let Tor pick fastest. Tray menu writes this at runtime via SETCONF.
+[exit]
+countries = []
+strict    = true
+
+# ---------- Post-quantum (opt-in, costs CPU) ---------------------------------
+[pqc]
+enabled  = false
+algo_sig = "dilithium2"
+algo_kem = "kyber1024"
+
+# ---------- Country/proxy hopping (off by default) ---------------------------
+[hop]
+enabled      = false
+randomize    = false
+loop_forever = true
+jitter       = "0s"
+sequence     = []
+
+# =============================================================================
+# [perf] — Speed tuning knobs
+# =============================================================================
+# These defaults assume you trust Tor's baseline anonymity and want throughput.
+# Every knob has a sane fallback in code, so removing one won't break anything.
+# =============================================================================
+[perf]
+# How many SOCKS ports tor opens.
+#
+# IMPORTANT: the bundled tun2socks bridge dials a SINGLE SOCKS port, so any
+# extra ports here just make tor build and maintain circuit pools that nothing
+# uses — wasted CPU and slower warm-up, not more throughput. Keep this at 1 for
+# this build; only raise it if you wire up a client that actually spreads load
+# across multiple ports. (The torrc generator guarantees these never collide
+# with the control/DNS ports, but there's no reason to open ports you can't use.)
+parallel_socks_ports        = 1
+
+# Tor drops circuits that take longer than this many seconds to build during
+# the learning phase. Lower = pickier = faster average latency, with the
+# tradeoff of slightly more rebuilds.
+circuit_build_timeout_secs  = 10
+
+# Number of guard nodes. Default tor = 1. Raising to 3 widens the fast-path
+# pool: if one guard is slow, traffic falls onto the next. Tiny anonymity cost,
+# big real-world latency win.
+num_entry_guards            = 3
+
+# Skip IPv6. Many exits have poor v6 connectivity and the dual-stack happy-
+# eyeballs race adds latency. Set false if you specifically need v6.
+ipv4_only                   = true
+
+# Disable circuit / connection padding. Padding exists to defeat traffic-
+# analysis fingerprinting; turning it off costs a small amount of that
+# protection in exchange for measurable latency reduction.
+disable_padding             = true
