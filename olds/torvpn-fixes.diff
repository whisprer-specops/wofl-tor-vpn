--- torvpn_extract/tor-vpn/installer/installer.iss	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/installer/installer.iss	2026-09-06 17:19:31.885592320 +0000
@@ -0,0 +1,165 @@
+﻿; =============================================================================
+; TorVPN -- Inno Setup installer script
+; =============================================================================
+; This produces a single TorVPN-Setup.exe that:
+;   * Installs to %ProgramFiles%\TorVPN
+;   * Bundles torvpn-svc.exe, torvpn-tray.exe, scripts/, profiles/, the Tor
+;     Expert Bundle, tun2socks.exe, and wintun.dll
+;   * Registers and starts the Windows service post-install
+;   * Adds the tray app to HKCU\...\Run for autostart at login
+;   * Cleanly uninstalls the service and removes everything
+;
+; Before compiling: run installer\stage.ps1 to download Tor + tun2socks +
+; wintun into installer\staging\. Then open this file in Inno Setup Compiler
+; (ISCC) or run from CLI:
+;
+;     ISCC.exe installer\installer.iss
+;
+; Output appears in installer\Output\TorVPN-Setup.exe
+; =============================================================================
+
+#define MyAppName        "TorVPN"
+#define MyAppVersion     "0.2.0"
+#define MyAppPublisher   "whispr.dev"
+#define MyAppURL         "https://whispr.dev/torvpn"
+#define MyAppSvcExe      "torvpn-svc.exe"
+#define MyAppTrayExe     "torvpn-tray.exe"
+#define MyAppServiceName "TorVPN"
+
+[Setup]
+AppId={{F4B6A8C2-5E2D-4C9B-9C2A-8D6E1A0B3F47}
+AppName={#MyAppName}
+AppVersion={#MyAppVersion}
+AppPublisher={#MyAppPublisher}
+AppPublisherURL={#MyAppURL}
+AppSupportURL={#MyAppURL}
+AppUpdatesURL={#MyAppURL}
+DefaultDirName={autopf}\{#MyAppName}
+DefaultGroupName={#MyAppName}
+DisableProgramGroupPage=yes
+OutputDir=Output
+OutputBaseFilename=TorVPN-Setup-{#MyAppVersion}
+Compression=lzma2/ultra64
+SolidCompression=yes
+WizardStyle=modern
+PrivilegesRequired=admin
+ArchitecturesInstallIn64BitMode=x64
+ArchitecturesAllowed=x64
+UninstallDisplayIcon={app}\{#MyAppTrayExe}
+SetupIconFile=staging\icons\app.ico
+DisableDirPage=auto
+DisableReadyPage=no
+ShowLanguageDialog=no
+
+[Languages]
+Name: "english"; MessagesFile: "compiler:Default.isl"
+
+[Tasks]
+Name: "autostart"; \
+    Description: "Start TorVPN tray icon at login (recommended)"; \
+    GroupDescription: "Startup options:"
+
+[Files]
+; ---- Core binaries (built by `cargo build --release` per crate) -------------
+Source: "..\target\release\{#MyAppSvcExe}";  DestDir: "{app}"; Flags: ignoreversion
+Source: "..\target\release\{#MyAppTrayExe}"; DestDir: "{app}"; Flags: ignoreversion
+
+; ---- Bundled PowerShell scripts ---------------------------------------------
+Source: "..\scripts\fw-apply.ps1";    DestDir: "{app}\scripts"; Flags: ignoreversion
+Source: "..\scripts\fw-teardown.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion
+Source: "..\scripts\dns-apply.ps1";   DestDir: "{app}\scripts"; Flags: ignoreversion
+Source: "..\scripts\dns-teardown.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion
+Source: "..\scripts\route-apply.ps1";    DestDir: "{app}\scripts"; Flags: ignoreversion
+Source: "..\scripts\route-teardown.ps1"; DestDir: "{app}\scripts"; Flags: ignoreversion
+
+; ---- Default profile (installed read-only; user override goes in ProgramData)
+Source: "..\profiles\default_win.toml"; DestDir: "{app}\profiles"; Flags: ignoreversion
+Source: "..\profiles\obfs4_win.toml";   DestDir: "{app}\profiles"; Flags: ignoreversion
+
+; ---- Tor expert bundle (staged by stage.ps1) --------------------------------
+; Note: Tor 0.4.7+ on Windows ships as a single statically-linked tor.exe with
+; NO loose DLLs. The *.dll line is kept (with skipifsourcedoesntexist) so this
+; works on both modern bundles and older ones that did ship DLLs.
+Source: "staging\tor\tor.exe";               DestDir: "{app}\tor";  Flags: ignoreversion
+Source: "staging\tor\*.dll";                 DestDir: "{app}\tor";  Flags: ignoreversion skipifsourcedoesntexist
+Source: "staging\tor\data\*";                DestDir: "{app}\tor\data"; Flags: ignoreversion recursesubdirs createallsubdirs skipifsourcedoesntexist
+
+; ---- tun2socks + Wintun driver ----------------------------------------------
+Source: "staging\tun2socks\tun2socks.exe";   DestDir: "{app}";      Flags: ignoreversion
+Source: "staging\wintun\wintun.dll";         DestDir: "{app}";      Flags: ignoreversion
+
+; ---- Optional: icon for the uninstaller entry -------------------------------
+Source: "staging\icons\app.ico"; DestDir: "{app}"; Flags: ignoreversion
+
+[Dirs]
+; ---- ProgramData state directory --------------------------------------------
+; Created world-readable so the user-mode tray can read the auth token written
+; by the LocalSystem service.
+Name: "{commonappdata}\torvpn"; Permissions: users-readexec
+
+[Icons]
+Name: "{group}\{#MyAppName}";                Filename: "{app}\{#MyAppTrayExe}"
+Name: "{group}\Uninstall {#MyAppName}";      Filename: "{uninstallexe}"
+Name: "{autodesktop}\{#MyAppName}";          Filename: "{app}\{#MyAppTrayExe}"; Tasks: autostart
+
+[Registry]
+; Autostart the tray icon at login (current user only).
+Root: HKCU; Subkey: "Software\Microsoft\Windows\CurrentVersion\Run"; \
+    ValueType: string; ValueName: "TorVPN"; ValueData: """{app}\{#MyAppTrayExe}"""; \
+    Flags: uninsdeletevalue; Tasks: autostart
+
+[Run]
+; ---- Install + start the Windows service (service-install does both) -------
+Filename: "{app}\{#MyAppSvcExe}"; Parameters: "service-install"; \
+    StatusMsg: "Registering and starting TorVPN service..."; \
+    Flags: runhidden waituntilterminated
+
+; ---- Launch tray immediately ------------------------------------------------
+Filename: "{app}\{#MyAppTrayExe}"; \
+    Description: "Launch {#MyAppName} tray icon now"; \
+    Flags: nowait postinstall skipifsilent
+
+[UninstallRun]
+; ---- Stop + unregister the service before file removal ---------------------
+; service-uninstall internally calls `sc stop` then `sc delete`.
+Filename: "{app}\{#MyAppSvcExe}"; Parameters: "service-uninstall"; \
+    Flags: runhidden waituntilterminated; RunOnceId: "RemoveTorVPN"
+
+; ---- Restore the default route before anything else, in case a tunnel is up -
+Filename: "powershell.exe"; \
+    Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\scripts\route-teardown.ps1"""; \
+    Flags: runhidden waituntilterminated; RunOnceId: "RouteTeardown"
+
+; ---- Tear down any leftover firewall / DNS state ---------------------------
+Filename: "powershell.exe"; \
+    Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\scripts\fw-teardown.ps1"""; \
+    Flags: runhidden waituntilterminated; RunOnceId: "FwTeardown"
+
+Filename: "powershell.exe"; \
+    Parameters: "-NoProfile -ExecutionPolicy Bypass -File ""{app}\scripts\dns-teardown.ps1"""; \
+    Flags: runhidden waituntilterminated; RunOnceId: "DnsTeardown"
+
+[UninstallDelete]
+; Wipe state directory on uninstall.
+Type: filesandordirs; Name: "{commonappdata}\torvpn"
+
+[Code]
+// ---------- Kill any running tray instances before file replacement ----------
+function PrepareToInstall(var NeedsRestart: Boolean): String;
+var
+  ResultCode: Integer;
+begin
+  Exec(ExpandConstant('{cmd}'), '/c taskkill /F /IM torvpn-tray.exe',
+       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
+  Result := '';
+end;
+
+// ---------- Same on uninstall (so we can delete the exe) ---------------------
+function InitializeUninstall(): Boolean;
+var
+  ResultCode: Integer;
+begin
+  Exec(ExpandConstant('{cmd}'), '/c taskkill /F /IM torvpn-tray.exe',
+       '', SW_HIDE, ewWaitUntilTerminated, ResultCode);
+  Result := True;
+end;
diff -ruN '--exclude=target' '--exclude=Output' '--exclude=.git' torvpn_extract/tor-vpn/installer/stage.ps1 torvpn-build/installer/stage.ps1
--- torvpn_extract/tor-vpn/installer/stage.ps1	1970-01-01 00:00:00.000000000 +0000
+++ torvpn-build/installer/stage.ps1	2026-09-06 16:32:15.274784347 +0000
@@ -0,0 +1,206 @@
+﻿# =============================================================================
+# TorVPN -- Installer staging script
+# =============================================================================
+# Downloads the third-party binaries we bundle into the installer:
+#   * Tor Expert Bundle (windows-x86_64) from torproject.org
+#   * tun2socks (windows-amd64) from xjasonlyu/tun2socks releases
+#   * Wintun driver (amd64) from wintun.net
+#
+# Run from PowerShell in the installer\ directory:
+#
+#     cd installer
+#     .\stage.ps1
+#
+# After staging, build the release binaries:
+#
+#     cd ..
+#     cargo build --release -p torvpn-svc
+#     cargo build --release -p torvpn-tray
+#
+# Then compile the Inno Setup script:
+#
+#     & "C:\Program Files (x86)\Inno Setup 6\ISCC.exe" installer\installer.iss
+#
+# Output: installer\Output\TorVPN-Setup-<version>.exe
+# =============================================================================
+
+[CmdletBinding()]
+param(
+    [string]$TorVersion       = "13.0.13",
+    [string]$Tun2SocksVersion = "v2.5.2",
+    [string]$WintunVersion    = "0.14.1",
+    [switch]$Force
+)
+
+$ErrorActionPreference = "Stop"
+[Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12
+
+# ----- Resolve paths ----------------------------------------------------------
+$StageDir  = Join-Path $PSScriptRoot "staging"
+$DownloadDir = Join-Path $StageDir   "_downloads"
+$TorDir    = Join-Path $StageDir "tor"
+$T2sDir    = Join-Path $StageDir "tun2socks"
+$WtnDir    = Join-Path $StageDir "wintun"
+$IconsDir  = Join-Path $StageDir "icons"
+
+foreach ($d in @($StageDir, $DownloadDir, $TorDir, $T2sDir, $WtnDir, $IconsDir)) {
+    New-Item -ItemType Directory -Force -Path $d | Out-Null
+}
+
+function Get-File {
+    param([string]$Url, [string]$Out)
+    if ((Test-Path $Out) -and (-not $Force)) {
+        Write-Host "  [cache] $Out"
+        return
+    }
+    Write-Host "  [GET ] $Url"
+    Invoke-WebRequest -Uri $Url -OutFile $Out -UseBasicParsing
+}
+
+# =============================================================================
+# 1. Tor Expert Bundle
+# =============================================================================
+Write-Host "[*] Staging Tor $TorVersion ..."
+$torArchive = Join-Path $DownloadDir "tor-expert-bundle.tar.gz"
+$torUrl = "https://archive.torproject.org/tor-package-archive/torbrowser/$TorVersion/tor-expert-bundle-windows-x86_64-$TorVersion.tar.gz"
+Get-File -Url $torUrl -Out $torArchive
+
+# Extract -- Windows 10+ ships with tar.exe
+$torExtractDir = Join-Path $DownloadDir "tor-extract"
+if (Test-Path $torExtractDir) { Remove-Item -Recurse -Force $torExtractDir }
+New-Item -ItemType Directory -Path $torExtractDir | Out-Null
+& tar.exe -xzf $torArchive -C $torExtractDir
+if ($LASTEXITCODE -ne 0) { throw "tar.exe failed extracting Tor bundle" }
+
+# Bundle layout:
+#   tor\tor.exe
+#   tor\libssl-3-x64.dll
+#   tor\libcrypto-3-x64.dll
+#   tor\zlib1.dll
+#   ... pluggable-transports\obfs4proxy.exe, snowflake-client.exe
+#   data\geoip, geoip6
+$bundleTorDir = Join-Path $torExtractDir "tor"
+$bundleDataDir = Join-Path $torExtractDir "data"
+
+if (-not (Test-Path (Join-Path $bundleTorDir "tor.exe"))) {
+    throw "tor.exe not found at $bundleTorDir -- bundle layout changed?"
+}
+
+# Copy tor.exe and its DLLs
+Copy-Item -Path (Join-Path $bundleTorDir "tor.exe") -Destination $TorDir -Force
+Copy-Item -Path (Join-Path $bundleTorDir "*.dll")   -Destination $TorDir -Force
+
+# Copy geoip files (Tor needs these for ExitNodes country selection)
+$torDataOut = Join-Path $TorDir "data"
+New-Item -ItemType Directory -Force -Path $torDataOut | Out-Null
+if (Test-Path $bundleDataDir) {
+    Copy-Item -Path (Join-Path $bundleDataDir "*") -Destination $torDataOut -Recurse -Force
+}
+
+Write-Host "  [ok ] tor.exe + DLLs + geoip staged"
+
+# =============================================================================
+# 2. tun2socks (xjasonlyu/tun2socks -- Wintun-capable build)
+# =============================================================================
+Write-Host "[*] Staging tun2socks $Tun2SocksVersion ..."
+$t2sZip = Join-Path $DownloadDir "tun2socks.zip"
+$t2sUrl = "https://github.com/xjasonlyu/tun2socks/releases/download/$Tun2SocksVersion/tun2socks-windows-amd64.zip"
+Get-File -Url $t2sUrl -Out $t2sZip
+
+$t2sExtractDir = Join-Path $DownloadDir "tun2socks-extract"
+if (Test-Path $t2sExtractDir) { Remove-Item -Recurse -Force $t2sExtractDir }
+Expand-Archive -Path $t2sZip -DestinationPath $t2sExtractDir -Force
+
+# Find tun2socks-windows-amd64.exe (release naming varies slightly)
+$t2sExe = Get-ChildItem -Path $t2sExtractDir -Recurse -Filter "tun2socks*.exe" |
+          Select-Object -First 1
+if (-not $t2sExe) { throw "tun2socks*.exe not found in $t2sExtractDir" }
+
+Copy-Item -Path $t2sExe.FullName -Destination (Join-Path $T2sDir "tun2socks.exe") -Force
+Write-Host "  [ok ] tun2socks.exe staged"
+
+# =============================================================================
+# 3. Wintun driver
+# =============================================================================
+Write-Host "[*] Staging Wintun $WintunVersion ..."
+$wtnZip = Join-Path $DownloadDir "wintun.zip"
+$wtnUrl = "https://www.wintun.net/builds/wintun-$WintunVersion.zip"
+Get-File -Url $wtnUrl -Out $wtnZip
+
+$wtnExtractDir = Join-Path $DownloadDir "wintun-extract"
+if (Test-Path $wtnExtractDir) { Remove-Item -Recurse -Force $wtnExtractDir }
+Expand-Archive -Path $wtnZip -DestinationPath $wtnExtractDir -Force
+
+# Layout: wintun\bin\amd64\wintun.dll
+$wtnDll = Join-Path $wtnExtractDir "wintun\bin\amd64\wintun.dll"
+if (-not (Test-Path $wtnDll)) {
+    # Fallback search
+    $wtnDll = (Get-ChildItem -Path $wtnExtractDir -Recurse -Filter "wintun.dll" |
+               Where-Object { $_.FullName -like "*amd64*" } |
+               Select-Object -First 1).FullName
+}
+if (-not $wtnDll -or -not (Test-Path $wtnDll)) {
+    throw "wintun.dll (amd64) not found in $wtnExtractDir"
+}
+Copy-Item -Path $wtnDll -Destination (Join-Path $WtnDir "wintun.dll") -Force
+Write-Host "  [ok ] wintun.dll staged"
+
+# =============================================================================
+# 4. App icon -- placeholder if user hasn't supplied one
+# =============================================================================
+$iconPath = Join-Path $IconsDir "app.ico"
+if (-not (Test-Path $iconPath)) {
+    Write-Host "[*] No app.ico found -- generating a 16x16 placeholder..."
+    # Minimal 16x16 ICO with a single dark-red filled square. Real branding
+    # should drop a proper multi-resolution .ico at staging\icons\app.ico
+    # before running stage.ps1 again.
+    Add-Type -AssemblyName System.Drawing
+    $bmp = New-Object System.Drawing.Bitmap 32, 32
+    $g   = [System.Drawing.Graphics]::FromImage($bmp)
+    $g.FillEllipse([System.Drawing.Brushes]::DarkRed, 2, 2, 28, 28)
+    $g.Dispose()
+    $icon = [System.Drawing.Icon]::FromHandle($bmp.GetHicon())
+    $fs = [System.IO.File]::Create($iconPath)
+    $icon.Save($fs)
+    $fs.Close()
